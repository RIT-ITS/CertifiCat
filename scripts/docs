#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
REPO_ROOT="$(realpath "${SCRIPT_DIR}/..")"

if ! command -v uv >/dev/null 2>&1; then
  echo "error: uv is required to build the documentation" >&2
  exit 1
fi

ACTION="build"

case "${1:-}" in
  build|serve)
    ACTION="$1"
    shift
    ;;
  ""|-*)
    ;;
  *)
    echo "usage: $0 [build|serve] [mkdocs options...]" >&2
    exit 2
    ;;
esac

exec uvx --with-requirements "$REPO_ROOT"/docs/requirements.txt mkdocs "${ACTION}" \
  --config-file "${REPO_ROOT}/docs/mkdocs.yml" \
  "$@"
